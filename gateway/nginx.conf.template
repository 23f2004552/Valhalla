worker_processes auto;

events {
    worker_connections 1024;
}

http {
    # ── Logging ──
    log_format json_combined escape=json
        '{"time":"$time_iso8601","remote_addr":"$remote_addr",'
        '"method":"$request_method","uri":"$request_uri",'
        '"status":$status,"body_bytes_sent":$body_bytes_sent,'
        '"upstream":"$upstream_addr","latency":"$request_time"}';

    access_log /dev/stdout json_combined;
    error_log  /dev/stderr warn;

    # ── Upstream Definitions ──
    upstream auth_upstream {
        server auth-service:5000;
    }
    upstream menu_upstream {
        server menu-service:5000;
    }
    upstream order_upstream {
        server order-service:5000;
    }
    upstream inventory_upstream {
        server inventory-service:5000;
    }
    upstream payment_upstream {
        server payment-service:5000;
    }
    upstream analytics_upstream {
        server analytics-service:5000;
    }

    server {
        listen 80;
        server_name _;

        # ── CORS Headers ──
        add_header Access-Control-Allow-Origin  "${FRONTEND_ORIGIN}" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Service-Token" always;
        add_header Access-Control-Allow-Credentials "true" always;

        # ── Preflight ──
        if ($request_method = OPTIONS) {
            return 204;
        }

        # ── Health ──
        location = /health {
            return 200 '{"status":"ok","gateway":"nginx"}';
            add_header Content-Type application/json;
        }

        # ── Auth Service ──
        location /api/auth/ {
            proxy_pass http://auth_upstream/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ── Menu Service ──
        location /api/menu {
            proxy_pass http://menu_upstream/menu;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location /api/categories {
            proxy_pass http://menu_upstream/categories;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # ── Order Service ──
        location /api/orders {
            proxy_pass http://order_upstream/orders;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # ── Inventory Service ──
        location /api/inventory {
            proxy_pass http://inventory_upstream/inventory;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # ── Payment Service ──
        location /api/payments {
            proxy_pass http://payment_upstream/payments;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # ── Analytics Service ──
        location /api/analytics/ {
            proxy_pass http://analytics_upstream/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }
    }
}
